[Unit]
Description=walletoperator (FastAPI)
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/walletoperator
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/walletoperator/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 5000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
